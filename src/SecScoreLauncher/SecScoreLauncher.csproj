<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <CreateSrpx>true</CreateSrpx>
        <IsPackable>false</IsPackable>
        <!-- Prefer the host checkout path supplied for this integration; keep the existing checkout as a fallback. -->
        <SecRandomSourceDir Condition="Exists('..\..\..\secrandom\_src\SecRandom.PluginSdk\SecRandom.PluginSdk.csproj')">..\..\..\secrandom\_src</SecRandomSourceDir>
        <SecRandomSourceDir Condition="'$(SecRandomSourceDir)' == ''">..\..\..\secrandom_src\SecRandom-master</SecRandomSourceDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- Reference the SDK for compile-time types only; the host supplies Core/PluginSdk/Avalonia at
             runtime, so their runtime assets (and Core's transitive deps) must not ship in the .srpx. -->
        <ProjectReference Include="$(SecRandomSourceDir)\SecRandom.PluginSdk\SecRandom.PluginSdk.csproj">
            <ExcludeAssets>runtime;native</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Bring in the SDK's packaging target so `dotnet build` produces the .srpx plugin package. -->
    <Import Project="$(SecRandomSourceDir)\SecRandom.PluginSdk\SecRandom.PluginSdk.targets" />
</Project>
