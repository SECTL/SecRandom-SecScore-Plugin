<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <CreateSrpx>true</CreateSrpx>
        <IsPackable>false</IsPackable>
        <!-- The SDK is referenced from source because SecRandom.PluginSdk is not published to public feeds. -->
        <SecRandomSourceDir>..\..\..\secrandom_src\SecRandom-master</SecRandomSourceDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(SecRandomSourceDir)\SecRandom.PluginSdk\SecRandom.PluginSdk.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Bring in the SDK's packaging target so `dotnet build` produces the .srpx plugin package. -->
    <Import Project="$(SecRandomSourceDir)\SecRandom.PluginSdk\SecRandom.PluginSdk.targets" />
</Project>
